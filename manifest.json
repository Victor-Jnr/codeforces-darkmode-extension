{
  "manifest_version": 3,
  "name": "Codeforces Dark Mode",
  "version": "1.0",
  "description": "Automatically applies dark mode to Codeforces website",
  "permissions": ["activeTab", "scripting", "storage"],
  "host_permissions": ["https://codeforces.com/*"],
  "content_scripts": [
    {
      "matches": ["https://codeforces.com/*"],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Codeforces Dark Mode"
  }
}
